{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "chrome",
      "node"
    ]
  },
  "include": [
    "adnbn.config.ts",
    "src/**/*.ts",
    "declaration.d.ts",
    "types.ts",
    ".adnbn/**/*.d.ts"
  ]
}
