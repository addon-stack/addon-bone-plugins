{
  "name": "@adnbn/plugin-remote-config",
  "version": "0.3.1",
  "description": "Remote config plugin for Addon Bone",
  "keywords": [
    "adnbn",
    "browser",
    "chrome",
    "opera",
    "firefox",
    "safari",
    "edge",
    "extension",
    "config",
    "remote"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/addon-stack/addon-bone-plugins.git",
    "directory": "packages/@adnbn/plugin-remote-config"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/addon-stack/addon-bone-plugins/tree/main/packages/%40adnbn/plugin-remote-config#readme",
  "bugs": {
    "url": "https://github.com/addon-stack/addon-bone-plugins/issues"
  },
  "license": "MIT",
  "author": "Addon Stack <addonbonedev@gmail.com>",
  "contributors": [
    "Anjey Tsibylskij (https://github.com/atldays)"
  ],
  "type": "module",
  "files": [
    "plugin",
    "dist-types"
  ],
  "types": "./dist-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "default": "./plugin/index.ts"
    },
    "./api": {
      "types": "./dist-types/api.d.ts",
      "default": "./plugin/api.ts"
    },
    "./react": {
      "types": "./dist-types/react/index.d.ts",
      "default": "./plugin/react/index.ts"
    },
    "./service": {
      "types": "./dist-types/service/index.d.ts",
      "default": "./plugin/service/index.ts"
    }
  },
  "scripts": {
    "build:types": "pnpm types",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "pack:check": "node ../../../tools/pack/verify-package.mjs .",
    "prepack": "pnpm types",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:coverage": "jest --config jest.config.cjs --coverage --runInBand",
    "test:watch": "jest --config jest.config.cjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tests/types/tsconfig.json --noEmit",
    "types": "node -e \"require('node:fs').rmSync('dist-types', {force: true, recursive: true})\" && tsc -p tsconfig.build.json",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm types && pnpm pack:check"
  },
  "dependencies": {
    "@addon-core/browser": "^0.8.0",
    "@addon-core/storage": "^0.7.0",
    "dot-prop": "^10.2.0",
    "type-fest": "^5.9.0"
  },
  "devDependencies": {
    "@rspack/core": "1.7.12",
    "@types/chrome": "^0.2.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "adnbn": "^0.10.0",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "peerDependencies": {
    "@rspack/core": "^1.7.5",
    "adnbn": ">=0.4.0",
    "react": "^16.8 || ^17.0 || ^18.0 || ^19.0 || ^19.0.0-rc"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
