{
  "name": "@adnbn/plugin-reg-cs",
  "version": "0.5.1",
  "description": "A plugin for Addon Bone that automatically registers and injects content scripts when your browser extension is installed",
  "keywords": [
    "adnbn",
    "browser",
    "chrome",
    "opera",
    "firefox",
    "safari",
    "edge",
    "extension",
    "content scripts",
    "manifest"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/addon-stack/addon-bone-plugins.git",
    "directory": "packages/@adnbn/plugin-reg-cs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/addon-stack/addon-bone-plugins/tree/main/packages/%40adnbn/plugin-reg-cs#readme",
  "bugs": {
    "url": "https://github.com/addon-stack/addon-bone-plugins/issues"
  },
  "license": "MIT",
  "author": "Anjey Tsibylskij (https://github.com/atldays)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "plugin",
    "dist-types"
  ],
  "types": "./dist-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "default": "./plugin/index.ts"
    },
    "./background": {
      "types": "./dist-types/background.d.ts",
      "default": "./plugin/background.ts"
    }
  },
  "scripts": {
    "build:types": "pnpm types",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "pack:check": "node ../../../tools/pack/verify-package.mjs .",
    "prepack": "pnpm types",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:coverage": "jest --config jest.config.cjs --coverage --runInBand",
    "test:watch": "jest --config jest.config.cjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "types": "tsc -p tsconfig.build.json",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm types && pnpm pack:check"
  },
  "dependencies": {
    "@addon-core/browser": "^0.8.0",
    "@addon-core/inject-css": "^0.4.0",
    "@addon-core/inject-script": "^0.5.0",
    "webext-patterns": "^3.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "adnbn": "^0.10.0"
  },
  "peerDependencies": {
    "adnbn": ">=0.4.0"
  }
}
