{
  "name": "@adnbn/plugin-reg-cs",
  "projectType": "library",
  "sourceRoot": "packages/@adnbn/plugin-reg-cs/plugin",
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": [
        "{projectRoot}/dist-types"
      ],
      "options": {
        "command": "pnpm verify",
        "cwd": "packages/@adnbn/plugin-reg-cs"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "pnpm lint",
        "cwd": "packages/@adnbn/plugin-reg-cs"
      }
    },
    "pack:check": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        "types"
      ],
      "options": {
        "command": "pnpm pack:check",
        "cwd": "packages/@adnbn/plugin-reg-cs"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "pnpm test",
        "cwd": "packages/@adnbn/plugin-reg-cs"
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "options": {
        "command": "pnpm test:coverage",
        "cwd": "packages/@adnbn/plugin-reg-cs"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "pnpm typecheck",
        "cwd": "packages/@adnbn/plugin-reg-cs"
      }
    },
    "types": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": [
        "{projectRoot}/dist-types"
      ],
      "options": {
        "command": "pnpm types",
        "cwd": "packages/@adnbn/plugin-reg-cs"
      }
    }
  }
}
