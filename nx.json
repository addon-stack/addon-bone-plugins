{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/.editorconfig",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/.npmrc",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/tools/eslint/**/*",
      "{workspaceRoot}/tools/pack/**/*",
      "{workspaceRoot}/tests/helpers/**/*"
    ]
  },
  "targetDefaults": {
    "nx:run-commands": {
      "inputs": [
        "default",
        "^default"
      ]
    }
  },
  "release": {
    "projects": [
      "packages/@adnbn/*"
    ],
    "projectsRelationship": "independent",
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    },
    "conventionalCommits": {
      "types": {
        "refactor": {
          "semverBump": "none",
          "changelog": {
            "title": "💅 Refactors",
            "hidden": false
          }
        },
        "deps": {
          "semverBump": "patch",
          "changelog": {
            "title": "📦 Dependencies",
            "hidden": false
          }
        },
        "ci": {
          "semverBump": "none",
          "changelog": false
        },
        "chore": {
          "semverBump": "none",
          "changelog": false
        }
      },
      "useCommitScope": true
    },
    "version": {
      "conventionalCommits": true,
      "adjustSemverBumpsForZeroMajorVersion": false,
      "updateDependents": "always",
      "versionActions": "./tools/release/VersionActions.cjs",
      "preVersionCommand": "node tools/release/check-dependency-history.mjs"
    },
    "changelog": {
      "projectChangelogs": {
        "createRelease": "github",
        "renderer": "{workspaceRoot}/tools/release/ChangelogRenderer.cjs"
      }
    },
    "git": {
      "commit": true,
      "tag": true,
      "commitMessage": "chore(release): publish {version}"
    }
  },
  "analytics": false,
  "pluginsConfig": {
    "@nx/js": {
      "projectsAffectedByDependencyUpdates": "auto"
    }
  }
}
