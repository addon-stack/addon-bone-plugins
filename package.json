{
  "name": "addon-bone-plugins-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.24.0"
  },
  "scripts": {
    "audit:security": "pnpm audit --audit-level high",
    "build:consumer": "node ./tools/smoke/plugin-reg-cs-consumer.mjs --keep-output",
    "check": "pnpm exec nx run-many -t check",
    "check:affected": "pnpm exec nx affected -t check",
    "check:browser": "node ./tools/smoke/plugin-reg-cs-browser.mjs",
    "check:consumer": "node ./tools/smoke/plugin-reg-cs-consumer.mjs",
    "format": "pnpm lint:fix",
    "format:check": "pnpm lint",
    "lint": "pnpm exec eslint . --max-warnings 0",
    "lint:fix": "pnpm exec eslint . --fix --max-warnings 0",
    "pack:check": "pnpm exec nx run-many -t pack:check",
    "prepare": "husky",
    "release": "pnpm exec nx release",
    "release:dry-run": "pnpm exec nx release --dry-run --skip-publish",
    "serve:consumer": "node ./tools/smoke/plugin-reg-cs-site.mjs",
    "test": "pnpm exec nx run-many -t test",
    "test:coverage": "pnpm exec nx run-many -t test:coverage",
    "test:tooling": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config tools/eslint/jest.config.cjs --runInBand",
    "typecheck": "pnpm exec nx run-many -t typecheck",
    "types": "pnpm exec nx run-many -t types",
    "verify": "pnpm lint && pnpm test:tooling && pnpm audit:security && pnpm check && pnpm check:consumer"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@nx/js": "23.1.2",
    "@swc/core": "^1.11.7",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.7.0",
    "husky": "9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^17.1.1",
    "nx": "23.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
